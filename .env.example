# Docker Compose uses secret files. Generate them with the command in the startup guide.
LEADMINER_DB_PASSWORD_FILE=./.secrets/db-password
LEADMINER_DB_URL_FILE=./.secrets/db-url
LEADMINER_API_PORT=8000

# Direct CLI without Docker. DATABASE_URL_FILE takes precedence over DATABASE_URL.
# DATABASE_URL_FILE=/path/to/local/db-url
# LEADMINER_OUTPUT_DIR=results

# Optional Groq and authorized browser adapters.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# LEADMINER_LEGACY_PROXY=http://egress-proxy:3128
